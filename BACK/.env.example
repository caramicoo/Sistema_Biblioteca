# Copie este arquivo para .env e preencha os valores antes de executar.
PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca
APP_TIMEZONE=America/Sao_Paulo
# Gere uma chave com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# URLs do frontend futuro (VS Code Live Server). Nao usar * em producao.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
