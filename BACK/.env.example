# Copie este arquivo para .env e preencha os valores antes de executar.
PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca
APP_TIMEZONE=America/Sao_Paulo
# Gere uma chave com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# O frontend servido pelo Express já tem acesso. Liste aqui outras origens permitidas, separadas por vírgula.
CORS_ORIGINS=
